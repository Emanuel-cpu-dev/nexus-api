PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
UPLOAD_DIR=./uploads
VITE_SERVER_URL=http://localhost:3000

# Ingreso nuevo (cuentas nuevas): Google + código por correo.
# Google Cloud -> Credenciales -> ID de cliente web. No es un secreto.
GOOGLE_CLIENT_ID=

# SMTP gratis (Outlook/Hotmail: smtp.office365.com:587; Gmail con contraseña de aplicación: smtp.gmail.com:587).
# Nunca pongas estas claves en el chat ni en el repo.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Dueño de la app. Se reconoce por usuario histórico o por este correo VERIFICADO.
OWNER_USERNAME=emaggi22
OWNER_EMAIL=ema.maggio.mdm@gmail.com
