{
  "name": "nexus-social-app",
  "version": "1.0.0",
  "private": true,
  "description": "Red social de escritorio con chat, llamadas y watch party",
  "author": "Proyecto Final",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev:server": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev:app": "vite --config app/vite.config.js",
    "build:web": "vite build --config app/vite.config.js",
    "dist:win": "npm run build:web && electron-builder --win --config electron-builder.config.cjs",
    "dist:portable": "npm run build:web && electron-builder --win portable --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.11",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "vite": "^6.1.0"
  }
}
